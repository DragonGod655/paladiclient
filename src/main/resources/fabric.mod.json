{
  "schemaVersion": 1,
  "name": "Paladi client",
  "id": "paladi-client",
  "version": "${version}",
  "description": "Based utility mod.",
  "authors": [
    "Đức Huy"
  ],
  "contact": {
    "homepage": "https://PaladiClient.com",
    "issues": "https://github.com/MeteorDevelopment/paladi-client/issues",
    "sources": "https://github.com/MeteorDevelopment/paladi-client",
    "discord": "https://PaladiClient.com/discord"
  },
  "license": "GPL-3.0",
  "icon": "assets/paladi-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "paladi.client.PaladiClient"
    ],
    "modmenu": [
      "paladi.client.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "paladi-client.mixins.json",
    "paladi-client-baritone.mixins.json",
    "paladi-client-indigo.mixins.json",
    "paladi-client-sodium.mixins.json",
    "paladi-client-lithium.mixins.json",
    "paladi-client-viafabricplus.mixins.json"
  ],
  "accessWidener": "paladi-client.accesswidener",
  "custom": {
    "paladi-client:build_number": "${build_number}",
    "paladi-client:color": "100,180,255",
    "paladi-client:commit": "${commit}",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://PaladiClient.com/discord"
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "paladi.client.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.8.7",
    "morechathistory": "*",
    "lithium": "<0.21.3"
  }
}
